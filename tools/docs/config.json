{
  "_comment": "Configuration for tools/docs/update_manual.py. Paths are relative to the repository root unless noted.",
  "manual_dir": "docs/manual",
  "src_dir": "docs/manual/src",
  "img_dir": "docs/manual/src/img",
  "registry": "docs/manual/registry.json",
  "state_file": "docs/manual/.manual-state.json",
  "style_guide": "tools/docs/STYLE.md",
  "generated": {
    "features": "reference/features.md",
    "changelog": "changelog.md"
  },
  "_path_modules_comment": "Maps changed source paths to manual modules for `revise`. Rules are tried in order and the FIRST matching glob wins. `**` matches across directories, `*` within one path segment. A rule with \"module\": null marks paths that never trigger a revision.",
  "path_modules": [
    {"glob": "docs/manual/**", "module": null},
    {"glob": "tools/docs/**", "module": null},
    {"glob": "**/tests/**", "module": null},
    {"glob": "**/*.md", "module": null},
    {"glob": "crates/ezyx-app/src/solid/**", "module": "solid"},
    {"glob": "crates/ezyx-app/src/image/**", "module": "image"},
    {"glob": "crates/ezyx-app/src/panels/image.rs", "module": "image"},
    {"glob": "crates/ezyx-app/src/machine/**", "module": "machine"},
    {"glob": "crates/ezyx-app/src/panels/machine.rs", "module": "machine"},
    {"glob": "crates/ezyx-app/src/assistant/**", "module": "assistant"},
    {"glob": "crates/ezyx-app/src/panels/ai.rs", "module": "assistant"},
    {"glob": "crates/ezyx-app/src/settings/**", "module": "settings"},
    {"glob": "crates/ezyx-app/src/**", "module": "pipeline"},
    {"glob": "crates/ezyx-machine/**", "module": "machine"},
    {"glob": "crates/ezyx-ai/**", "module": "assistant"},
    {"glob": "crates/ezyx-project/src/agent_host.rs", "module": "assistant"},
    {"glob": "crates/ezyx-image/**", "module": "image"},
    {"glob": "crates/ezyx-cad/**", "module": "solid"},
    {"glob": "crates/ezyx-mesh/**", "module": "solid"},
    {"glob": "crates/ezyx-gpu/**", "module": "settings"},
    {"glob": "crates/ezyx-cam/**", "module": "pipeline"},
    {"glob": "crates/ezyx-gcode/**", "module": "pipeline"},
    {"glob": "crates/ezyx-sim/**", "module": "pipeline"},
    {"glob": "crates/ezyx-tooldb/**", "module": "pipeline"},
    {"glob": "crates/ezyx-materials/**", "module": "pipeline"},
    {"glob": "crates/ezyx-core/**", "module": "pipeline"},
    {"glob": "crates/ezyx-project/**", "module": "pipeline"},
    {"glob": "examples/**", "module": "pipeline"}
  ],
  "_ignore_commit_types_comment": "Conventional-commit types whose commits never trigger a source-driven revision (they still appear in the changelog).",
  "ignore_commit_types": ["test", "ci", "chore", "style", "build"],
  "changelog_ignore_types": ["ci", "style"],
  "changelog_max_commits": 200,
  "model": "claude-opus-5-5",
  "effort": "medium",
  "max_tokens": 32000,
  "max_chapters_per_run": 12,
  "diff_max_chars": 24000,
  "log_max_commits": 60
}
